{
  "name": "ideal-hospital",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5174",
    "show": "npm run build && vite preview --host 127.0.0.1 --port 5174",
    "typecheck": "tsc --noEmit",
    "fetch-assets": "node tools/fetch-assets.mjs",
    "convert-people": "node --import tsx tools/convert-people.mjs",
    "test": "vitest run --maxWorkers=2",
    "test:quick": "QUICK_TESTS=1 vitest run --maxWorkers=2",
    "arch:plan": "tsx tools/arch/export-plan.ts",
    "arch:bake": "mkdir -p assets-src/arch/out/zones && ~/Applications/Blender.app/Contents/MacOS/Blender -b --factory-startup -P tools/arch/generate.py --",
    "arch:stills": "~/Applications/Blender.app/Contents/MacOS/Blender -b --factory-startup -P tools/arch/generate.py -- --zone lobby --no-bake --stills docs/screenshots --all-poses",
    "arch:build": "node tools/arch/optimize.mjs",
    "arch:zones:draft": "npm run arch:plan && npm run arch:bake -- --zone all --draft --stills docs/screenshots && npm run arch:build -- --zone all",
    "arch:zones": "npm run arch:plan && npm run arch:bake -- --zone all --stills docs/screenshots && npm run arch:build -- --zone all",
    "copy-basis": "node tools/copy-basis.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@react-three/postprocessing": "3.1.3",
    "@sparkjsdev/spark": "2.3.1",
    "camera-controls": "3.1.2",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "xstate": "5.33.2",
    "yuka": "0.7.8",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "gltf-validator": "2.0.0-dev.3.10",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
