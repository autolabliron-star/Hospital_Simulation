  "erTests": {
    "Severe difficulty breathing": {
      "chance": 1,
      "redFlag": true,
      "bloods": "er-chest",
      "imaging": "xr-chest"
    },
    "Breathless and struggling to speak": {
      "chance": 1,
      "redFlag": true,
      "bloods": "er-chest",
      "imaging": "xr-chest"
    },
    "Collapsed, not fully conscious": {
      "chance": 1,
      "redFlag": true,
      "bloods": "er-faint",
      "ecg": true,
      "imaging": "ct-head"
    },
    "Collapsed at home, slow to respond": {
      "chance": 1,
      "redFlag": true,
      "bloods": "er-faint",
      "ecg": true,
      "imaging": "ct-head"
    },
